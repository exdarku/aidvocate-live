# ===========================================
# AidVocate Environment Configuration
# ===========================================
# Thesis-grade privacy-preserving donation verification.
# The thesis backend (server/) uses safe defaults — no .env required
# to boot. Set these only when connecting to a real blockchain.

# --- server/.env (Express + SQLite + ZKP backend) ---
# Set NODE_ENV=production in prod — this makes the server FAIL TO BOOT if
# JWT_SECRET is missing/weak, and hides internal error messages from clients.
NODE_ENV=development
PORT=3001

# REQUIRED in production. Must be >= 32 chars of randomness.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h

# bcrypt work factor (higher = slower = more brute-force resistant)
BCRYPT_ROUNDS=12

# Comma-separated list of allowed browser origins for CORS in production,
# e.g. https://app.aidvocate.org,https://aidvocate.org
# Leave blank in dev to reflect any origin.
CORS_ORIGIN=

# --- MySQL (AWS RDS or any MySQL 8+) ---
# MYSQL_USER and MYSQL_DATABASE are REQUIRED in production (the server refuses
# to boot without them). On AWS RDS set MYSQL_SSL=true to enforce TLS.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=aidvocate
MYSQL_PASSWORD=
MYSQL_DATABASE=aidvocate
MYSQL_SSL=false

# Blockchain (defaults to local Hardhat node at 127.0.0.1:8545)
RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=
# Hardhat account #0 dev key — DO NOT use in production
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# AWS S3 (file/document storage) — leave blank to disable
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# --- client/.env (Vite frontend) ---
VITE_API_URL=http://localhost:3001/api
